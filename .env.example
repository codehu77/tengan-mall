# 複製成 .env 後再依需要調整，正式環境務必全部換成非預設值
MYSQL_ROOT_PASSWORD=tengan123
REDIS_PASSWORD=tengan123
RABBITMQ_USER=tengan
RABBITMQ_PASSWORD=tengan123
MINIO_ROOT_USER=tengan
MINIO_ROOT_PASSWORD=tengan123456

# Nacos 2.x 強制要求設定驗證用的 token/identity，開發環境可用預設值，正式環境務必更換
NACOS_AUTH_TOKEN=ZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZg==
NACOS_AUTH_IDENTITY_KEY=tengan-nacos
NACOS_AUTH_IDENTITY_VALUE=tengan123

# Nacos 開啟 auth 後預設沒有任何帳號，第一次啟動需手動呼叫 API 建立管理員帳號才能用（見開發順序與清單.md Phase 0）
# 建立指令：curl -X POST "http://localhost:8848/nacos/v1/auth/users/admin?password=$NACOS_ADMIN_PASSWORD"
# 各服務的 spring.cloud.nacos.discovery/config.username/password 都填這組
NACOS_ADMIN_USERNAME=nacos
NACOS_ADMIN_PASSWORD=tengan123
