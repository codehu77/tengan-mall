<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tengan.mall</groupId>
    <artifactId>tengan-mall-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>tengan-devtools</artifactId>
  <packaging>jar</packaging>

  <!--
    一次性內部小工具：從 MOMO 商品頁抓 demo 資料，透過既有 tengan-product/tengan-media 的
    internal API 寫入。不連任何資料庫、不掛 Nacos discovery/config——不是正式對外服務，只在
    本機手動啟動使用，client_credentials 的 client 註冊/服務位址直接寫死在自己的
    application.yml（見 tengan-auth 的 RegisteredClientSeeder 新增的 tengan-devtools client）。
  -->

  <properties>
    <playwright.version>1.52.0</playwright.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>

    <!-- 瀏覽器自動化渲染 MOMO 的 JS 動態頁面，不在 Spring Boot BOM 管理範圍內，自己釘版本 -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
    </dependency>
    <!-- 解析 MOMO 商品特色區塊的 iframe srcdoc（seller 自己上傳的雜亂 HTML），比手刻 regex 穩定 -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.18.1</version>
    </dependency>
    <!-- spring-web 的 MultipartBodyBuilder（MediaApiClient 上傳圖片用）內部有幾個 reactive 版本的
         part(...) 多載方法，class 檔的常數池裡引用了 org.reactivestreams.Publisher；
         spring-boot-starter-web 預設不帶這個，沒有的話一用 MultipartBodyBuilder 就會
         NoClassDefFoundError。版本交給 Spring Boot BOM 管，不用自己釘。 -->
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
